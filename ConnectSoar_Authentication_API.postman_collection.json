{
  "info": {
    "_postman_id": "c7e8490a-115b-4de0-8e4d-connectsoar-auth",
    "name": "ConnectSoar — Authentication API",
    "description": "Postman Collection for ConnectSoar Real Backend Authentication APIs deployed on Render (https://connectsoar-backend.onrender.com). Conforms strictly to the provided API documentation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://connectsoar-backend.onrender.com",
      "type": "string"
    },
    {
      "key": "email",
      "value": "employee@example.com",
      "type": "string"
    },
    {
      "key": "password",
      "value": "UserPassword123!",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "resetPasswordToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 or 403 (Password Change Required)\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 403]);",
              "});",
              "var jsonData = pm.response.json();",
              "if (pm.response.code === 200) {",
              "    pm.test(\"Login successful with tokens\", function () {",
              "        pm.expect(jsonData.success).to.eql(true);",
              "        pm.expect(jsonData.data.access_token).to.be.a('string');",
              "        pm.expect(jsonData.data.refresh_token).to.be.a('string');",
              "        pm.collectionVariables.set(\"accessToken\", jsonData.data.access_token);",
              "        pm.collectionVariables.set(\"refreshToken\", jsonData.data.refresh_token);",
              "    });",
              "} else if (pm.response.code === 403 && jsonData.error && jsonData.error.code === 'PASSWORD_CHANGE_REQUIRED') {",
              "    pm.test(\"Password change required detected\", function () {",
              "        pm.expect(jsonData.data.password_reset_token).to.be.a('string');",
              "        pm.collectionVariables.set(\"resetPasswordToken\", jsonData.data.password_reset_token);",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02 Refresh Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Rotated tokens returned\", function () {",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.access_token).to.be.a('string');",
              "    pm.expect(jsonData.data.refresh_token).to.be.a('string');",
              "    pm.collectionVariables.set(\"accessToken\", jsonData.data.access_token);",
              "    pm.collectionVariables.set(\"refreshToken\", jsonData.data.refresh_token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/refresh",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "refresh"
          ]
        }
      },
      "response": []
    },
    {
      "name": "03 Current User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Current user profile retrieved\", function () {",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.id).to.be.a('string');",
              "    pm.expect(jsonData.data.email).to.be.a('string');",
              "    pm.expect(jsonData.data.role).to.be.a('string');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "me"
          ]
        }
      },
      "response": []
    },
